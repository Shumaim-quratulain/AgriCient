# Copy to a file kept ONLY on the server (never in git). In AWS, prefer Secrets Manager or SSM Parameter Store.
# Database (RDS)
DB_URL=jdbc:mysql://YOUR-RDS-ENDPOINT.rds.amazonaws.com:3306/agricient?useSSL=true&requireSSL=true
DB_USER=agricient
DB_PASSWORD=change-me
# "update" creates missing tables on the first start; switch to "validate" afterwards
DB_DDL=update

# Push notifications (generate your own keys; see the guide)
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:you@example.com

# Officer sign-up code (leave empty to switch officer sign-up off)
OFFICER_INVITE_CODE=

# Text messages: "log" simulates; "twilio" sends (needs a paid account for your own wording)
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM=
TWILIO_TRIAL_TEMPLATE=
